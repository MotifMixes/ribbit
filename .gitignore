/target/

# User-supplied firmware, game images and save data must never be committed.
*.bin
*.BIN
*.rom
*.nvram
*.sav
/local/
/roms/
*.zip
*.7z
/tools/
*.eeprom
*.apk
*.keystore
*.ppm
# Synthetic CPU test programs generated by scripts/gen-cpu-vectors.py (not firmware).
!crates/ribbit-cpu/tests/vectors/*.bin
# The built-in art-capture profile (made by Ribbit; no personal data).
!crates/ribbit-frontend/src/art_profile.eeprom
zippity/
# Downloaded RockIt Twist packages (LeapFrog firmware and encrypted game packs).
/leapfrog-rockit-twist-apps/
# Flash files extracted from cartridges.
*.swf

# LeapPad cartridge dumps (copyrighted; kept out of the repository).
/LeapPad_Reading_System_Archive/
# Local Claude Code settings and Python caches.
/.claude/
__pycache__/
